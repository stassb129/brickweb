# BrickWeb backend environment variables
#
# Copy to apps/backend/.env for local overrides (optional — defaults work with docker-compose).

# HTTP
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database — local docker-compose defaults
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=brickweb

# Production (Railway / managed Postgres): set DATABASE_URL instead of DB_* above.
# Example: postgres://user:pass@host:5432/brickweb
# DATABASE_URL=
# DATABASE_SSL=true
# TYPEORM_SYNC=true

# Frontend (apps/frontend/.env.local)
# Leave empty in development so Next.js proxies /api/* → localhost:4000
# NEXT_PUBLIC_API_URL=
# Production example:
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
